# Secrets — never commit local credentials
.claude/settings.local.json

# Claude Code worktrees — local isolated working copies, not project state
.claude/worktrees/

# Throwaway adapter prototype (de-risk artifact). Kept on disk as a v0.1
# reference, NOT project code — see prototype/adapter/run.sh header "Do NOT promote".
prototype/

# Python / uv — environment is managed by uv (see DEVELOPMENT.md).
# uv.lock IS committed for reproducibility; the venv + build metadata are not.
.venv/
__pycache__/
*.py[cod]
src/*.egg-info/

# macOS
.DS_Store

# ai-dev runtime state. Feature runs created by local CLI runs in THIS dev repo
# are throwaway demo output, not project state. (In a real *target* project,
# .ai-dev/ is the committed source of truth per spec §4.1 — that rule applies to
# the project being developed, not to the orchestrator's own repo.)
.ai-dev/

# llm-api
/settings-*.json
